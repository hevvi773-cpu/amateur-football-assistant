# ===== 足球AI助手 配置文件 =====
# 复制本文件后，填入你的大模型 API Key 即可启用 AI 文本生成功能
# 不填也能用，AI 文本会自动降级为内置模板生成器；比分预测不受影响（用本地ML模型）

# AI 模式：auto = 配好密钥用真实大模型，否则自动降级；mock = 强制用模板；llm = 强制用大模型（无密钥会报错）
AI_MODE=auto

# 大模型 API（OpenAI 兼容接口）
# 豆包火山方舟示例：
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_API_KEY=你的火山方舟Key
#   LLM_MODEL=ep-xxxxxxxx
#
# 通义千问 DashScope 示例：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_API_KEY=sk-xxxxxxxx
#   LLM_MODEL=qwen-plus
LLM_API_KEY=在这里粘贴你的DeepSeek的sk-xxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
