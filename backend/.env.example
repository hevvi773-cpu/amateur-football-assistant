# ===== 足球AI助手 后端配置示例 =====
# 复制本文件为 .env 后按需修改

# AI 模式：auto = 配好密钥用真实大模型，否则自动降级为内置模板生成器
# 可选值：auto / mock / llm
AI_MODE=auto

# 大模型 API（OpenAI 兼容接口）
# 豆包火山方舟示例：
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_API_KEY=你的火山方舟Key
#   LLM_MODEL=ep-xxxxxxxx
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
