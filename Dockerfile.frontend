# 足球AI助手 - 前端镜像（多阶段构建）
# 阶段1：构建 React 静态文件
FROM node:20-alpine AS builder

WORKDIR /app

# 先装依赖（利用缓存）
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --ignore-scripts --no-audit --no-fund

# 复制源码
COPY frontend/ .

# Docker 环境下 API 走相对路径 /api（由 nginx 反代到 backend）
RUN sed -i 's|http://localhost:8010/api|/api|g' src/lib/api.ts

# 构建静态文件
RUN npx vite build

# 替换 miaoda 平台模板变量为实际值（纯 nginx 环境不会注入这些变量）
RUN node scripts/fix-docker-template.mjs

# 阶段2：nginx 托管静态文件 + 反代 API
FROM nginx:alpine

# 复制构建产物（preset 输出到 dist/client/）
COPY --from=builder /app/dist/client /usr/share/nginx/html

# 复制 nginx 配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
